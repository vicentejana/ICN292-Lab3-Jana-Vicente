      "id": "abded082-e791-5654-8b84-aa584193c62c",
      "name": "Resumir por ruta",
      "type": "n8n-nodes-base.summarize",
      "typeVersion": 1.1,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const filas = $input.all().map(i => i.json).filter(r => r.ruta);\nconst rutas = ['APROBACION', 'REVISION', 'RECHAZO', 'DATOS_INVALIDOS'];\nconst fmt = n => '$' + Math.round(n).toLocaleString('es-CL');\nconst total = filas.reduce((a, r) => a + (r.count_id_solicitud || 0), 0);\nconst fecha = $now.setZone('America/Santiago').toFormat('dd-MM-yyyy');\nif (total === 0) {\n  return [{ json: { fecha, total: 0, mensaje: `Resumen AndesHogar ${fecha}: hoy no se recibieron solicitudes de devolución.` } }];\n}\nconst lineas = rutas.map(ruta => {\n  const f = filas.find(r => r.ruta === ruta) || { count_id_solicitud: 0, sum_monto: 0 };\n  return `- ${ruta}: ${f.count_id_solicitud} solicitudes, monto ${fmt(f.sum_monto || 0)}`;\n});\nconst aprob = (filas.find(r => r.ruta === 'APROBACION') || {}).count_id_solicitud || 0;\nconst tasa = Math.round(aprob / total * 1000) / 10;\nconst texto = [`Resumen AndesHogar ${fecha}`, ...lineas, `Total: ${total} solicitudes`, `Tasa de aprobación automática: ${tasa}% (${aprob}/${total})`].join('\\n');\nreturn [{ json: { fecha, total, tasa_aprobacion_automatica: tasa, mensaje: texto } }];\n"
      },
      "id": "17149634-412e-577b-a6a1-619829e79c88",
      "name": "Construir mensaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
